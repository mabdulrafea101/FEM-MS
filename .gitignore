# ============================================================================
# KEEP: ESSENTIAL FILES (Whitelist)
# ============================================================================
# Add exceptions for files that should be tracked
# (Git will ignore patterns above but not these)

# Model files (keep latest)
!simulation/models/
!simulation/models/best_model_CatBoost.pkl
!simulation/models/scaler.pkl

# Validation figures (keep all - used in document)
!docs/figures/
!docs/figures/validation_studies/
!docs/figures/validation_studies/mesh_convergence_study.png
!docs/figures/validation_studies/mode_shape_validation.png
!docs/figures/validation_studies/damage_factor_sensitivity.png
!docs/figures/validation_studies/uncertainty_propagation.png
!docs/figures/validation_studies/zhang_comparison.png

# Gautam validation figures (used in document)
!docs/figures/gautam_validation/
!docs/figures/gautam_validation/fe_model_gautam.png
!docs/figures/gautam_validation/validation_comparison.png
!docs/figures/gautam_validation/mode_shapes.png

# ML figures (used in document)
!simulation/outputs/ml_figures/
!simulation/outputs/ml_figures/parameter_distributions.png
!simulation/outputs/ml_figures/correlation_matrix.png
!simulation/outputs/ml_figures/damage_vs_frequency.png

# Dataset figure (used in document)
!simulation/outputs/figures/
!simulation/outputs/figures/dataset_distribution.png

# Core simulation code (keep latest)
!simulation/src/
!simulation/src/*.py

# Test files
!simulation/tests/
!simulation/tests/validation.py

# Latest scripts (keep only current versions)
!scripts/
!scripts/comprehensive_validation.py
!scripts/validate_gautam_2016.py
!scripts/generate_thesis_docx.js

# Documentation files (keep)
!documentation_humanized.md
!CRITICAL_EVALUATION.md
!RE_EVALUATION.md
!REVISION_CHECKLIST.md
!FINAL_SUBMISSION_SUMMARY.md

# Thesis output (keep)
!MS_FINAL_THESIS.docx

# Configuration files
!.claude/
!.claude/CLAUDE.md
!.claude/plans/

# ============================================================================
# NOTES
# ============================================================================
# This .gitignore configuration ensures minimal repository bloat while
# maintaining all essential files needed for:
# 1. Thesis defense and committee submission
# 2. Reproducibility of ML models
# 3. Validation studies and evidence
# 4. Future publication/sharing
#
# Total tracked files: ~30 files
# Approximate repo size: ~5-10 MB
# ============================================================================

# ============================================================================
# new-ML pipeline (revised thesis) — track notebook, tables, models, logs
# ============================================================================
!new-ML/model_training_ansys.ipynb
!new-ML/outputs/
!new-ML/outputs/figures/
!new-ML/outputs/figures/*
!new-ML/outputs/tables/
!new-ML/outputs/tables/*
!new-ML/outputs/models/
!new-ML/outputs/models/*
!new-ML/outputs/logs/
!new-ML/outputs/logs/*
