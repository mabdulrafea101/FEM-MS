# ============================================================================
# RESEARCH MATERIALS TO EXCLUDE
# ============================================================================
# PDF files (too large, keep only essential ones)
*.pdf
# Exception: Reference PDFs (listed below as allowed)

# Research papers and drafts
refrences/
draft/
research_papers/

# ============================================================================
# DATA FILES TO EXCLUDE
# ============================================================================
# Old and intermediate data
beam_vibration_dataset.csv
*.csv
*.xlsx
*.xls
*.json
*.xml

# Database files
*.db
*.sqlite
*.sqlite3

