simple_extract.py
pdf_extract_helper.py
extract_new_pdf.py

# Old conversion scripts (keeping only latest: generate_thesis_docx.js)
convert_md_to_docx.js
convert_md_to_docx_enhanced.js
create_final_thesis.js

# CatBoost training outputs
catboost_info/
*.catboost_info

# Old and intermediate DOCX files (keeping only MS_FINAL_THESIS.docx)
MS_Thesis_Document.docx
MS_Thesis_ch_1_2_3.docx
thesis_final_formatted.docx

# Unpacked DOCX directories (intermediate processing)
docx_unpacked/
new-chapters/

# Simulation logs and intermediate outputs
simulation/logs/
simulation/outputs/

# Old markdown chapters (keeping only documentation_humanized.md)
Chapters_1_2_3_Only.md

